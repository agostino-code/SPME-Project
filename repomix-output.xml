    margin-bottom: 1.2rem;
    opacity: 0.4;
}

.placeholder-results h3 {
    font-size: 1.1rem;
    font-weight: 600;
    margin-bottom: 0.4rem;
    color: var(--text-color);
    opacity: 0.45;
}

.placeholder-results p {
    font-size: 0.82rem;
    max-width: 300px;
    opacity: 0.5;
}

/* ==========================================================================
   RESULTS CONTAINER
   ========================================================================== */
.results-container {
    display: none;
    flex-direction: column;
    gap: 1.8rem;
}

/* ==========================================================================
   METRICS ROW (HLFPA, IFPA, FP)
   ========================================================================== */
.metrics-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.9rem;
}

.metric-item {
    background: rgba(0, 0, 0, 0.2);
    border: 1px solid var(--card-border);
    border-radius: var(--radius-md);
    padding: 0.9rem 0.7rem;
    text-align: center;
    transition: all var(--transition);
}

.metric-item:hover {
    border-color: rgba(91, 141, 239, 0.18);
    transform: translateY(-1px);
}

.metric-item span {
    display: block;
    font-size: 0.62rem;
    color: var(--text-dim);
    text-transform: uppercase;
    font-weight: 700;
    letter-spacing: 0.8px;
    margin-bottom: 0.25rem;
}

.metric-item strong {
    font-family: 'Outfit', sans-serif;
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--accent);
}

/* ==========================================================================
   PREDICTION CARDS (2x2 grid)
   ========================================================================== */
.prediction-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
}

.prediction-card {
    background: rgba(0, 0, 0, 0.18);
    border: 1px solid var(--card-border);
    border-radius: var(--radius-md);
    padding: 1.3rem 1.2rem;
    transition: all var(--transition);
    position: relative;
    overflow: hidden;
}

.prediction-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    border-radius: var(--radius-md) var(--radius-md) 0 0;
}

.prediction-card.slr::before {
    background: linear-gradient(90deg, var(--accent), var(--purple));
}

.prediction-card.dcnn::before {
    background: linear-gradient(90deg, var(--primary), var(--success));
}

.prediction-card:hover {
    border-color: var(--card-hover);
    transform: translateY(-2px);
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.3);
}

.prediction-card .card-model {
    font-family: 'Outfit', sans-serif;
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.6px;
    margin-bottom: 0.2rem;
}

.prediction-card .card-formula {
    font-size: 0.72rem;
    color: var(--text-dim);
    margin-bottom: 0.7rem;
}

.prediction-card .card-value {
    font-family: 'Outfit', sans-serif;
    font-size: 1.9rem;
    font-weight: 800;
    color: var(--text-color);
    letter-spacing: -0.5px;
}

.prediction-card .card-unit {
    font-size: 0.72rem;
    color: var(--text-dim);
    font-weight: 500;
    margin-left: 0.3rem;
}

/* ==========================================================================
   ERROR COMPARISON PANEL
   ========================================================================== */
.error-comparison {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.2rem;
}

.error-model-card {
    background: rgba(0, 0, 0, 0.15);
    border: 1px solid var(--card-border);
    border-radius: var(--radius-md);
    padding: 1.3rem 1.2rem;
    position: relative;
}

.error-model-card.lr-card {
    border-left: 3px solid var(--accent);
}

.error-model-card.dcnn-card {
    border-left: 3px solid var(--primary);
}

.error-model-card .error-model-name {
    font-family: 'Outfit', sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 1rem;
}

.error-model-card.lr-card .error-model-name { color: var(--accent); }
.error-model-card.dcnn-card .error-model-name { color: var(--primary); }

.error-metric-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.55rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.03);
}

.error-metric-row:last-child {
    border-bottom: none;
}

.error-metric-label {
    font-size: 0.75rem;
    color: var(--text-muted);
    font-weight: 500;
}

.error-metric-value {
    font-family: 'Outfit', sans-serif;
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text-color);
}

/* Visual bar for error */
.error-bar-container {
    margin-top: 1rem;
}

.error-bar-row {
    margin-bottom: 0.7rem;
}

.error-bar-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 0.3rem;
}

.error-bar-label {
    font-size: 0.68rem;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.error-bar-val {
    font-family: 'Outfit', sans-serif;
    font-size: 0.78rem;
    font-weight: 600;
}

.error-bar-track {
    height: 8px;
    background: rgba(0, 0, 0, 0.3);
    border-radius: 4px;
    overflow: hidden;
    position: relative;
}

.error-bar-fill {
    height: 100%;
    border-radius: 4px;
    transition: width 1s cubic-bezier(0.16, 1, 0.3, 1);
}

.error-bar-fill.lr { background: linear-gradient(90deg, var(--accent), var(--purple)); }
.error-bar-fill.dcnn { background: linear-gradient(90deg, var(--primary), var(--success)); }

/* Winner badge */
.winner-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.35rem 0.75rem;
    border-radius: 8px;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.4px;
    margin-top: 0.8rem;
}

.winner-badge.dcnn-wins {
    background: rgba(0, 228, 255, 0.1);
    color: var(--primary);
    border: 1px solid rgba(0, 228, 255, 0.2);
}

.winner-badge.lr-wins {
    background: rgba(91, 141, 239, 0.1);
    color: var(--accent);
    border: 1px solid rgba(91, 141, 239, 0.2);
}

/* Improvement percentage */
.improvement {
    text-align: center;
    padding: 1rem;
    background: rgba(0, 0, 0, 0.15);
    border-radius: var(--radius-md);
    border: 1px solid var(--card-border);
}

.improvement-value {
    font-family: 'Outfit', sans-serif;
    font-size: 2rem;
    font-weight: 800;
    background: linear-gradient(135deg, var(--primary), var(--success));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

.improvement-label {
    font-size: 0.72rem;
    color: var(--text-muted);
    font-weight: 500;
    margin-top: 0.15rem;
}

/* ==========================================================================
   FOOTER
   ========================================================================== */
footer {
    padding: 1.6rem 2rem;
    text-align: center;
    font-size: 0.72rem;
    color: var(--text-dim);
    border-top: 1px solid var(--card-border);
    margin-top: auto;
    background: rgba(8, 10, 18, 0.5);
    backdrop-filter: blur(10px);
}

/* ==========================================================================
   ANIMATIONS
   ========================================================================== */
@keyframes fadeIn {
    from { opacity: 0; }
    to   { opacity: 1; }
}

@keyframes fadeInUp {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
}

@keyframes spin {
    to { transform: rotate(360deg); }
}

/* ==========================================================================
   RESPONSIVE
   ========================================================================== */
@media (max-width: 1100px) {
    .main-grid {
        grid-template-columns: 1fr;
        padding: 1.8rem 1.5rem;
    }
    header {
        padding: 1rem 1.5rem;
        flex-direction: column;
        align-items: flex-start;
        gap: 0.7rem;
    }
    .stats-badge-container {
        width: 100%;
        justify-content: flex-start;
    }
    .prediction-grid {
        grid-template-columns: 1fr;
    }
    .error-comparison {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 600px) {
    .form-grid {
        grid-template-columns: 1fr;
    }
    .form-section {
        grid-column: span 1;
    }
    .submit-btn {
        grid-column: span 1;
    }
    .metrics-row {
        grid-template-columns: 1fr;
    }
}

.presets-row {
    display: flex;
    gap: 0.65rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
    align-items: center;
}

.preset-btn {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--card-border);
    color: var(--text-color);
    padding: 0.45rem 0.85rem;
    border-radius: var(--radius-sm);
    font-size: 0.8rem;
    font-family: inherit;
    font-weight: 500;
    cursor: pointer;
    transition: all var(--transition);
}

.preset-btn:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: var(--accent);
    box-shadow: 0 0 10px var(--accent-glow);
    transform: translateY(-1px);
}
